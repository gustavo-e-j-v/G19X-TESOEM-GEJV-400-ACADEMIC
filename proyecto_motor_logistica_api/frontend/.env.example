# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo .env NO se sube a Git. Lo que ves aquí son valores de EJEMPLO.
# Después de cambiar .env, reinicia "npm run dev".

# Dirección de la API (backend)
VITE_API_BASE=http://localhost:8000

# Modo local SIN Entra ID (solo desarrollo o revisión local).
# El backend también debe tener AUTH_DISABLED=true en su .env.
VITE_AUTH_DISABLED=false

# Microsoft Entra ID: identificadores del Portal de Azure (la guía está en el README)
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_FRONTEND_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Opcional: URL de retorno del inicio de sesión (por defecto, la dirección desde la que abres la app)
# VITE_REDIRECT_URI=http://localhost:5173
