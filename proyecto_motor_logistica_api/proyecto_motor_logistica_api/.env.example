# =====================================================================
# Copia este archivo como ".env" (en esta misma carpeta, junto a
# docker-compose.yml) y cambia los valores. El archivo .env NO se sube
# a Git. Todo lo que ves aquí son valores de EJEMPLO, no reales.
# =====================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=almacen_db

# --- Autenticación con Microsoft Entra ID ---
# Identificadores de la app del BACKEND (Portal de Azure > Registros de aplicaciones).
# La guía para obtenerlos está en el README.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# true solo si inicias sesión con una cuenta personal o invitada de tu tenant de pruebas
AZURE_ALLOW_GUEST_USERS=false

# --- Modo local SIN Entra ID (solo desarrollo o revisión local) ---
# true = la API no valida tokens. NO lo uses en un servidor accesible desde internet.
AUTH_DISABLED=false

# --- Otros ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Mexico_City
